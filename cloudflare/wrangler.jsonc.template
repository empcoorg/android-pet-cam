{
  // Wrangler config for one camera's Worker. Copy this file to wrangler.jsonc (git-ignored),
  // fill in the placeholders, and deploy from this directory with: npm run deploy
  // See cloudflare/README.md for the full walkthrough.
  "name": "pet-cam-<name>",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Create with: npx wrangler r2 bucket create pet-cam-<name>-clips
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "pet-cam-<name>-clips" }],

  // Workers AI runs importance detection (vision model) on uploaded photos. Optional — remove
  // this block and the digest simply lists clips/photos without AI labels.
  "ai": { "binding": "AI" },

  // Catalog of clips/photos and trusted browsers. Create with:
  //   npx wrangler d1 create pet-cam-<name>-catalog
  // then paste the printed database_id below, and apply the schema:
  //   npx wrangler d1 execute pet-cam-<name>-catalog --remote --file schema.sql
  "d1_databases": [{ "binding": "DB", "database_name": "pet-cam-<name>-catalog", "database_id": "<PASTE_D1_ID_HERE>" }],

  // Transactional email for the daily digest and offline alerts (sender domain must be
  // onboarded to Email Sending). Optional — remove this block to disable email entirely.
  "send_email": [{ "name": "EMAIL" }],

  // One Durable Object instance fans live frames out from the phone to browser viewers.
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "CameraRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CameraRoom"] }],

  // Cloud retention sweep (also runs opportunistically after each upload).
  // */30 = cloud retention sweep; 0 14 = daily digest email at 14:00 UTC.
  "triggers": { "crons": ["*/30 * * * *", "0 14 * * *"] },

  "vars": {
    // 5 GiB. Oldest objects are deleted once the bucket exceeds this.
    "MAX_STORAGE_BYTES": "5368709120",
    // Viewer session lifetime in seconds (30 days).
    "SESSION_TTL_SECONDS": "2592000",
    // Optional email digest/alerts — leave blank (and remove send_email) to disable.
    "DIGEST_TO": "<your-email>",
    "DIGEST_FROM": "<sender@your-onboarded-domain>",
    "PUBLIC_URL": "https://pet-cam-<name>.<your-subdomain>.workers.dev",
    // Camera's local time zone offset in minutes (file names use local time).
    "CAMERA_UTC_OFFSET_MINUTES": "0",
    // Email DIGEST_TO when the camera has not reported for this long (reminder every 12h, and a back-online email).
    "OFFLINE_ALERT_MINUTES": "10",
    // Shown in the authenticator app during TOTP enrollment, e.g. "Pet Cam (kitchen)".
    "CAMERA_LABEL": "<name>"
  }

  // Secrets (set after deploying, each scoped to THIS camera's Worker name):
  //   npx wrangler secret put DEVICE_TOKEN
  //   npx wrangler secret put SESSION_SECRET
  //   npx wrangler secret put VIEWER_PASSWORD
  // DEVICE_TOKEN_APP is optional — only needed if you bake a token into the APK via app/keys.properties.
}